# =====================================================================
# قیمت — محیط توسعه‌ی محلی
#   cp .env.development.example .env
#
# تفاوت اصلی با سرور: نام میزبان دیتابیس و Redis اینجا localhost است،
# چون `npm run dev` بیرون از شبکه‌ی داکر اجرا می‌شود.
# =====================================================================

DATABASE_URL=postgresql://qeymat:qeymat@localhost:5432/qeymat?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
AUTH_SECRET=dev-only-secret-replace-me-with-at-least-32-characters
WORKER_TOKEN=dev-worker-token

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# npm run vapid:generate — بدون این‌ها فقط اعلان خاموش است، بقیه سایت کار می‌کند
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@qeymat.online

ADMIN_EMAIL=admin@qeymat.online
ADMIN_PASSWORD=admin12345

USDT_WALLET_ADDRESS=
ASAPAY_URL=https://asapay.pro
HISTORY_INTERVAL_MINUTES=15
