# =====================================================================
# قیمت — متغیرهای محیطی
# این فایل را روی سرور به .env کپی کنید و مقادیر واقعی را بگذارید.
#   cp .env.example .env
# فایل .env هرگز کامیت نمی‌شود.
# =====================================================================

# --- دیتابیس ---------------------------------------------------------
POSTGRES_USER=qeymat
POSTGRES_PASSWORD=یک-گذرواژه-قوی-بگذارید
POSTGRES_DB=qeymat
# نام میزبان `postgres` است چون داخل شبکه‌ی داکر اجرا می‌شود
DATABASE_URL=postgresql://qeymat:یک-گذرواژه-قوی-بگذارید@postgres:5432/qeymat?schema=public
WEB_PORT=3100
# --- امنیت -----------------------------------------------------------
# کلید امضای نشست. حداقل ۳۲ کاراکتر. تولید:
#   openssl rand -base64 48
AUTH_SECRET=

# توکن داخلی برای فراخوانی دستی کرالر از پنل مدیریت. تولید:
#   openssl rand -hex 24
WORKER_TOKEN=

# --- سایت ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://qeymat.online
WEB_PORT=3000

# --- اعلان مرورگر (VAPID) --------------------------------------------
# تولید با: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@qeymat.online

# --- حساب مدیر اولیه --------------------------------------------------
# فقط در اولین seed استفاده می‌شود. بعد از ساخت حساب، خالی بگذارید.
ADMIN_EMAIL=admin@qeymat.online
ADMIN_PASSWORD=

# --- پرداخت تتری ------------------------------------------------------
USDT_WALLET_ADDRESS=

# --- آساپی ------------------------------------------------------------
ASAPAY_URL=https://asapay.pro

# --- کرالر ------------------------------------------------------------
# فاصله‌ی ثبت نقطه در تاریخچه (دقیقه)
HISTORY_INTERVAL_MINUTES=15
# نگهداشت تاریخچه (روز)
HISTORY_RETENTION_DAYS=400
# در صورت نیاز، User-Agent اختصاصی برای منابع
CRAWLER_USER_AGENT=

# --- تصاویر (توسط GitHub Actions پر می‌شود) ---------------------------
IMAGE_WEB=ghcr.io/USERNAME/qeymat-web:latest
IMAGE_WORKER=ghcr.io/USERNAME/qeymat-worker:latest

# --- درگاه پرداخت زرین‌پال -------------------------------------------
# مرچنت آیدی ۳۶ کاراکتری از پنل زرین‌پال
ZARINPAL_MERCHANT_ID=
# برای تست روی sandbox مقدار true بگذارید
ZARINPAL_SANDBOX=false

# --- پیامک (کاوه‌نگار) -----------------------------------------------
SMS_PROVIDER=kavenegar
# کلید API پنل کاوه‌نگار
SMS_API_KEY=
# نام الگوی verify که در کاوه‌نگار ساخته‌اید
SMS_TEMPLATE=qeymat-otp

# --- بازارهای جهانی (Twelve Data) ------------------------------------
# کلید از twelvedata.com — برای نفت، فلزات، سهام و شاخص‌ها
TWELVE_DATA_API_KEY=


# --- رله‌ی تلگرام -----------------------------------------------------
# t.me از ایران فیلتر است؛ آدرس Worker کلادفلر را اینجا بگذارید
TELEGRAM_RELAY_URL=https://tg.qeymat.online
TELEGRAM_RELAY_TOKEN="qeymat_123456ZSp@7h^("

# --- موتور اجماع ------------------------------------------------------
# نقل‌قول قدیمی‌تر از این، در محاسبه‌ی نرخ نهایی شرکت نمی‌کند
QUOTE_TTL_MINUTES=30
# زیر این حد اطمینان، نرخ منتشر نمی‌شود و قبلی حفظ می‌شود
MIN_CONFIDENCE=0.35
# ضریب حذف پرت‌ها؛ عدد کوچک‌تر یعنی سخت‌گیرتر
OUTLIER_FACTOR=3