{
  "name": "qeymat",
  "version": "1.0.0",
  "private": true,
  "description": "قیمت — مرجع نرخ لحظه‌ای ارز، طلا، سکه و رمزارز",
  "author": "علی چترایی — تیم برنامه‌نویسی آ",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@qeymat/web",
    "dev:worker": "npm run dev --workspace=@qeymat/worker",
    "build": "npm run build --workspace=@qeymat/db && npm run build --workspace=@qeymat/web",
    "start": "npm run start --workspace=@qeymat/web",
    "lint": "npm run lint --workspace=@qeymat/web",
    "db:generate": "npm run generate --workspace=@qeymat/db",
    "db:migrate": "npm run migrate --workspace=@qeymat/db",
    
    "db:push": "npm run push --workspace=@qeymat/db",
    "db:seed": "npm run seed --workspace=@qeymat/db",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
