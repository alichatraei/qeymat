generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  // تصویر production روی alpine اجرا می‌شود، پس موتور musl هم لازم است
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetCategory {
  CURRENCY
  GOLD
  CRYPTO
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SourceStatus {
  ONLINE
  SLOW
  DOWN
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum OrderStatus {
  NEW
  PAID
  DELIVERED
  CANCELLED
}

/// یک دارایی قابل قیمت‌گذاری: ارز، طلا/سکه یا رمزارز
model Asset {
  id          String        @id @default(cuid())
  symbol      String        @unique
  nameFa      String
  nameEn      String
  category    AssetCategory
  /// کد کشور برای نمایش پرچم (ISO-3166 alpha-2) — فقط برای ارزها
  countryCode String?
  /// نشانه متنی برای طلا و رمزارز (₮ / ₿ / Ξ …)
  mark        String?
  /// واحد قیمت خروجی؛ همیشه تومان
  unit        String        @default("TOMAN")
  /// نام منبع برای نمایش در جدول
  sourceLabel String        @default("بازار آزاد")
  /// کلید منبع داده‌ای که این دارایی را تأمین می‌کند
  sourceKey   String
  /// کلید دارایی در پاسخ منبع (مثلاً usd یا btc)
  sourceField String
  /// ضریب تبدیل واحد منبع به تومان (ریال ← تومان = 0.1)
  multiplier  Float         @default(1)
  sortOrder   Int           @default(100)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rate    Rate?
  history RateHistory[]
  alerts  PriceAlert[]

  @@index([category, sortOrder])
}

/// آخرین نرخ هر دارایی — همیشه یک ردیف به ازای هر دارایی
model Rate {
  id            String   @id @default(cuid())
  assetId       String   @unique
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buy           Float
  sell          Float
  changePercent Float    @default(0)
  dayLow        Float?
  dayHigh       Float?
  /// قیمت جهانی دارایی (برای رمزارز: USDT)
  globalPrice   Float?
  source        String
  fetchedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// تاریخچه قیمت برای نمودارها
model RateHistory {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buy     Float
  sell    Float
  at      DateTime @default(now())

  @@index([assetId, at])
}

/// منابع داده و وضعیت سلامتشان — از پنل مدیریت قابل تنظیم است
model Source {
  id            String       @id @default(cuid())
  key           String       @unique
  title         String
  /// نوع آداپتور: nobitex | alanchand | bonbast | tgju | custom-json
  adapter       String
  endpoint      String
  intervalSec   Int          @default(60)
  isActive      Boolean      @default(true)
  status        SourceStatus @default(ONLINE)
  lastFetchedAt DateTime?
  lastLatencyMs Int?
  lastError     String?
  /// تنظیمات اختصاصی آداپتور (هدرها، مسیر فیلدها و …)
  config        Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys           ApiKey[]
  subscriptions     Subscription[]
  payments          Payment[]
  pushSubscriptions PushSubscription[]
  aiOrders          AiOrder[]
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @default("کلید اصلی")
  /// پیشوند قابل نمایش (qym_live_ABCD)
  prefix     String
  /// هش SHA-256 کلید کامل — کلید خام هرگز ذخیره نمی‌شود
  keyHash    String    @unique
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  usage UsageLog[]

  @@index([userId])
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String
  requestLimit Int
  requestsUsed Int                @default(0)
  status       SubscriptionStatus @default(ACTIVE)
  startsAt     DateTime           @default(now())
  expiresAt    DateTime
  createdAt    DateTime           @default(now())

  @@index([userId, status])
}

model Payment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String
  amountUsdt Float
  network    String        @default("BEP20")
  txHash     String
  status     PaymentStatus @default(PENDING)
  note       String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

model UsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint  String
  status    Int      @default(200)
  latencyMs Int      @default(0)
  at        DateTime @default(now())

  @@index([apiKeyId, at])
  @@index([endpoint, at])
}

/// اشتراک وب‌پوش مرورگر
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  alerts PriceAlert[]
}

/// هشدار قیمت روی یک دارایی
model PriceAlert {
  id        String           @id @default(cuid())
  subId     String
  sub       PushSubscription @relation(fields: [subId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  direction AlertDirection
  threshold Float
  isActive  Boolean          @default(true)
  firedAt   DateTime?
  createdAt DateTime         @default(now())

  @@index([assetId, isActive])
}

/// محصولات اکانت هوش مصنوعی و پرداخت ارزی (واسط آساپی)
model AiProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  description String
  /// نام آیکون lucide برای نمایش
  icon        String   @default("Sparkles")
  priceUsd    Float
  /// درصد کارمزد روی نرخ روز دلار
  feePercent  Float    @default(10)
  /// در صورت پر بودن، قیمت ثابت تومانی جایگزین محاسبه پویا می‌شود
  fixedToman  Float?
  period      String   @default("ماهانه")
  features    String[]
  badge       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders AiOrder[]
}

model AiOrder {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId  String
  product    AiProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fullName   String
  contact    String
  note       String?
  amountToma Float
  status     OrderStatus @default(NEW)
  /// شناسه ارجاع در سامانه آساپی
  asapayRef  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, createdAt])
}

/// تنظیمات کلید-مقدار سامانه
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
