generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  // تصویر production روی alpine اجرا می‌شود، پس موتور musl هم لازم است
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetCategory {
  CURRENCY
  GOLD
  CRYPTO
  COMMODITY
  STOCK
  INDEX
}

/// سطح دسترسی هر دارایی: رایگان یا مخصوص مشترکان قیمت پلاس
enum AssetTier {
  FREE
  PLUS
}

enum OtpPurpose {
  LOGIN
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum GatewayStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// نوع چیزی که خریداری می‌شود
enum ProductKind {
  API_PLAN
  PLUS_PLAN
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SourceStatus {
  ONLINE
  SLOW
  DOWN
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum OrderStatus {
  NEW
  PAID
  DELIVERED
  CANCELLED
}

/// یک دارایی قابل قیمت‌گذاری: ارز، طلا/سکه یا رمزارز
model Asset {
  id          String        @id @default(cuid())
  symbol      String        @unique
  nameFa      String
  nameEn      String
  category    AssetCategory
  /// کد کشور برای نمایش پرچم (ISO-3166 alpha-2) — فقط برای ارزها
  countryCode String?
  /// نشانه متنی برای طلا و رمزارز (₮ / ₿ / Ξ …)
  mark        String?
  /// واحد قیمت خروجی؛ همیشه تومان
  unit        String        @default("TOMAN")
  /// نام منبع برای نمایش در جدول
  sourceLabel String        @default("بازار آزاد")
  /// کلید منبع داده‌ای که این دارایی را تأمین می‌کند
  sourceKey   String
  /// کلید دارایی در پاسخ منبع (مثلاً usd یا btc)
  sourceField String
  /// ضریب تبدیل واحد منبع به تومان (ریال ← تومان = 0.1)
  multiplier  Float         @default(1)
  /// FREE برای همه، PLUS فقط برای مشترکان قیمت پلاس
  tier        AssetTier     @default(FREE)
  sortOrder   Int           @default(100)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quotes      SourceQuote[]
  rate        Rate?
  history     RateHistory[]
  daily       RateDaily[]
  alerts      PriceAlert[]

  @@index([category, tier, sortOrder])
}

/// آخرین نرخ هر دارایی — همیشه یک ردیف به ازای هر دارایی
model Rate {
  id            String   @id @default(cuid())
  assetId       String   @unique
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buy           Float
  sell          Float
  changePercent Float    @default(0)
  dayLow        Float?
  dayHigh       Float?
  /// قیمت جهانی دارایی (برای رمزارز: USDT)
  globalPrice   Float?
  source        String
  fetchedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// میزان توافق منابع روی این نرخ، بین ۰ تا ۱
  confidence    Float    @default(0)
  /// چند منبع در محاسبه‌ی این نرخ شرکت کرده‌اند
  sourceCount   Int      @default(0)
}

/// نقل‌قول خام هر منبع برای هر دارایی — ورودی موتور اجماع
model SourceQuote {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sourceKey String
  buy       Float?
  sell      Float
  at        DateTime @default(now())

  @@unique([assetId, sourceKey])
  @@index([assetId, at])
}

/// تاریخچه قیمت برای نمودارها
model RateHistory {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buy     Float
  sell    Float
  at      DateTime @default(now())

  @@index([assetId, at])
}

/// کندل روزانه — پایه‌ی نمودارهای بلندمدت (تا ۱۰ سال).
/// از سه راه پر می‌شود: جمع‌بندی نرخ زنده (live)، بک‌فیل تاریخچه‌ی TGJU (tgju)
/// و درون‌ریزی فایل CSV (csv). برخلاف RateHistory هرگز پاک نمی‌شود.
model RateDaily {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// روز تقویمی تهران
  day     DateTime @db.Date
  open    Float
  high    Float
  low     Float
  close   Float
  source  String   @default("live")

  @@unique([assetId, day])
  @@index([assetId, day])
}

/// منابع داده و وضعیت سلامتشان — از پنل مدیریت قابل تنظیم است
model Source {
  id            String       @id @default(cuid())
  key           String       @unique
  title         String
  /// نوع آداپتور: nobitex | alanchand | bonbast | tgju | custom-json
  adapter       String
  endpoint      String
  intervalSec   Int          @default(60)
  isActive      Boolean      @default(true)
  status        SourceStatus @default(ONLINE)
  lastFetchedAt DateTime?
  lastLatencyMs Int?
  lastError     String?
  /// تنظیمات اختصاصی آداپتور (هدرها، مسیر فیلدها و …)
  config        Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  /// وزن این منبع در اجماع؛ منبع معتبرتر عدد بزرگ‌تر
  weight        Float        @default(1)
  /// کیفیت یادگرفته‌شده‌ی منبع (۰ تا ۱): هرچه نقل‌قول‌هایش به نرخ نهایی
  /// نزدیک‌تر باشد بالاتر می‌رود. در وزن اجماع ضرب می‌شود.
  quality       Float        @default(1)
}

model User {
  id           String  @id @default(cuid())
  /// شماره موبایل نرمال‌شده به فرم 09xxxxxxxxx — روش اصلی ورود
  phone        String? @unique
  /// ایمیل اختیاری است؛ فقط برای حساب‌های قدیمی و مدیران
  email        String? @unique
  name         String  @default("کاربر قیمت")
  /// فقط برای مدیرانی که با ایمیل و گذرواژه وارد می‌شوند
  passwordHash String?

  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)
  phoneVerifiedAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  apiKeys           ApiKey[]
  subscriptions     Subscription[]
  plusSubscriptions PlusSubscription[]
  payments          Payment[]
  orders            GatewayOrder[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  pushSubscriptions PushSubscription[]
  aiOrders          AiOrder[]
  alerts            PriceAlert[]

  @@index([phone])
}

/// کد یک‌بارمصرف ورود. فقط هش کد ذخیره می‌شود.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  ip         String?

  @@index([phone, createdAt])
}

/// اشتراک «قیمت پلاس» — دسترسی به دارایی‌های سطح PLUS در سایت و اپ
model PlusSubscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  expiresAt DateTime
  /// سفارشی که این اشتراک را فعال کرده است
  orderId   String?
  createdAt DateTime           @default(now())

  @@index([userId, status])
}

/// سفارش پرداخت از درگاه زرین‌پال — هم برای پلن API و هم قیمت پلاس
model GatewayOrder {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ProductKind
  plan       String
  /// مبلغ به ریال — واحدی که زرین‌پال می‌پذیرد
  amountRial Int
  status     GatewayStatus @default(PENDING)
  /// شناسه‌ای که زرین‌پال هنگام درخواست پرداخت می‌دهد
  authority  String?       @unique
  /// شماره پیگیری پس از تأیید موفق
  refId      String?
  cardPan    String?
  failReason String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model Ticket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  category    String         @default("عمومی")
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  /// برای نشان‌دادن نشان «پاسخ تازه» در پنل کاربر
  lastReplyAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
  @@index([status, lastReplyAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// پیام از سمت پشتیبانی است یا کاربر
  fromStaff Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @default("کلید اصلی")
  /// پیشوند قابل نمایش (qym_live_ABCD)
  prefix     String
  /// هش SHA-256 کلید کامل — کلید خام هرگز ذخیره نمی‌شود
  keyHash    String    @unique
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  usage UsageLog[]

  @@index([userId])
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String
  requestLimit Int
  requestsUsed Int                @default(0)
  status       SubscriptionStatus @default(ACTIVE)
  startsAt     DateTime           @default(now())
  expiresAt    DateTime
  createdAt    DateTime           @default(now())

  @@index([userId, status])
}

model Payment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String
  amountUsdt Float
  network    String        @default("BEP20")
  txHash     String
  status     PaymentStatus @default(PENDING)
  note       String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

model UsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint  String
  status    Int      @default(200)
  latencyMs Int      @default(0)
  at        DateTime @default(now())

  @@index([apiKeyId, at])
  @@index([endpoint, at])
}

/// اشتراک وب‌پوش مرورگر
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  alerts PriceAlert[]
}

/// هشدار قیمت روی یک دارایی — فقط برای کاربر واردشده (با شماره موبایل)
model PriceAlert {
  id        String            @id @default(cuid())
  /// صاحب هشدار؛ هشدارهای نسخه‌ی قدیم ممکن است کاربر نداشته باشند
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// اشتراک پوش نسخه‌ی قدیم؛ در نسخه‌ی ۲ اعلان به همه‌ی دستگاه‌های کاربر می‌رود
  subId     String?
  sub       PushSubscription? @relation(fields: [subId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  direction AlertDirection
  threshold Float
  /// اعلان مرورگر — برای همه‌ی کاربران واردشده
  push      Boolean           @default(true)
  /// پیامک — فقط برای مشترکان قیمت پلاس، تا سقف پلن
  sms       Boolean           @default(false)
  isActive  Boolean           @default(true)
  firedAt   DateTime?
  createdAt DateTime          @default(now())

  @@index([assetId, isActive])
  @@index([userId, isActive])
}

/// محصولات اکانت هوش مصنوعی و پرداخت ارزی (واسط آساپی)
model AiProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  description String
  /// نام آیکون lucide برای نمایش
  icon        String   @default("Sparkles")
  priceUsd    Float
  /// درصد کارمزد روی نرخ روز دلار
  feePercent  Float    @default(10)
  /// در صورت پر بودن، قیمت ثابت تومانی جایگزین محاسبه پویا می‌شود
  fixedToman  Float?
  period      String   @default("ماهانه")
  features    String[]
  badge       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders AiOrder[]
}

model AiOrder {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId  String
  product    AiProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fullName   String
  contact    String
  note       String?
  amountToma Float
  status     OrderStatus @default(NEW)
  /// شناسه ارجاع در سامانه آساپی
  asapayRef  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, createdAt])
}

/// تنظیمات کلید-مقدار سامانه
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
